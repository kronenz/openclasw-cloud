{
  "name": "openclasw-cloud",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config infra/wrangler.toml",
    "build": "wrangler deploy --config infra/wrangler.toml --dry-run --outdir dist",
    "deploy": "wrangler deploy --config infra/wrangler.toml",
    "deploy:staging": "wrangler deploy --config infra/wrangler.toml --env staging",
    "deploy:production": "wrangler deploy --config infra/wrangler.toml --env production",
    "db:migrate": "wrangler d1 execute openclasw-db --config infra/wrangler.toml --file src/db/schema.sql",
    "db:migrate:v2": "wrangler d1 execute openclasw-db --config infra/wrangler.toml --file src/db/schema-v2.sql",
    "db:migrate:staging": "wrangler d1 execute openclasw-db-staging --config infra/wrangler.toml --env staging --file src/db/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250205.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^3.105.0"
  }
}
